# UDAAN Frontend Configuration
# Copy this file to .env and update the values

# Backend API Base URL
# Development: http://localhost:8000/api
# Staging: https://staging-api.udaan.example.com/api
# Production: https://api.udaan.example.com/api
VITE_API_BASE_URL=http://localhost:8000/api

# API request timeout in milliseconds (default: 15000)
VITE_API_TIMEOUT=15000

# Enable debug logging for API requests (true/false)
VITE_API_DEBUG=false
